# Wall-E setup environment.
#
# Copy to ~/.walle-env and fill in every <placeholder>. The script REFUSES to run
# while any value still looks like <this>, so an unedited copy cannot damage
# anything.
#
#   cp walle.env.example ~/.walle-env && $EDITOR ~/.walle-env
#
# This file is shell-sourceable on purpose: `source ~/.walle-env` gives you the
# same variables the runbook's own command blocks assume (SETUP.md 1.7), so you
# can follow SETUP.md by hand at any point without translating anything.
#
# It holds NO secrets. Passwords live in the corporate vault; tokens live in
# Secret Manager. If you find yourself pasting a secret in here, stop.
#
# You do not have to fill it all in before you start. The script validates only
# the keys the SUBCOMMAND YOU RAN actually uses, and a refusal names which
# subcommands want the missing key. `walle gcp` needs neither
# OPERATOR_OAUTH_CLIENT_FILE nor SANDBOX_ACCOUNTS; `walle workspace` needs both.
#
# No value below may contain a SEMICOLON. It is the delimiter for the Cloud Run
# --set-env-vars escaped list (SETUP.md Phase 10), gcloud requires the delimiter
# to appear in no value, and the script refuses to build the flag otherwise. It
# is ";" and not "@" precisely because so many of these values are addresses.

# ---- identity and naming (decision D1) --------------------------------------
# D1 is close to irreversible in one respect: the OAuth app name is shown to the
# robot on the consent screen and is awkward to change afterwards.

# Not the vanity domain. The one users' addresses actually end in.
export DOMAIN="<primary-domain>"

# SETUP.md proposes an id. The id can never be reused after a delete.
export PROJECT="<project-id>"

# Do not change. Agent Runtime is GA here with EU at-rest residency, and the
# whole residency posture in ARCHITECTURE.md section 9 is written against it.
# The script refuses any other value.
export REGION="europe-west1"
export BQ_LOCATION="EU"

# gcloud organizations list
export ORG_ID="<org-id>"
# gcloud billing accounts list. You need Billing Account User AND Billing
# Account Costs Manager: the first links the project, the second creates the
# budget, and the failure lands on the last command of phase 6.
export BILLING="<billing-account>"
# Admin console, Account settings. my_customer works in most API calls.
export CUSTOMER_ID="my_customer"

# ---- principals -------------------------------------------------------------
export ROBOT="walle@${DOMAIN}"
export EVE_ROBOT="eve@${DOMAIN}"
export OPERATORS="walle-operators@${DOMAIN}"
export READERS="walle-readers@${DOMAIN}"
export PROTECTED="walle-protected@${DOMAIN}"

# You. Used for group ownership, the floor list header, and the preflight check
# that gcloud and the Admin SDK are the same person.
export OPERATOR_EMAIL="<your-address>"
export OPERATOR_NAME="<your-name>"

# D5. The other named Workspace admin. Leave empty and the script
# records a one-member operators group as a known risk: legal, and it means
# every kill switch depends on you being awake.
export SECOND_OPERATOR=""

# ---- organisational units (decision D3) -------------------------------------
# The robot needs its own unit so the phase 3 hardening applies to it and to
# nothing else. Applying hardware-key-only 2SV at the root would change every
# employee.
export SVC_OU="/Automation/Service Identities"

# D3. A sandbox with synthetic accounts, and one small real pilot unit. Without
# a sandbox, Stage 1's first real writes land on real employees.
export PILOT_OU="<pilot-ou>"
export SANDBOX_OU="<sandbox-ou>"

# At least three. They consume licences. Name them so nobody mistakes them for
# staff. They are the ONLY targets any verification step may name.
export SANDBOX_ACCOUNTS="walle-test-01@${DOMAIN},walle-test-02@${DOMAIN},walle-test-03@${DOMAIN}"

# ---- local paths ------------------------------------------------------------
# The Wall-E code repository. Phases 7, 10, 11, 12 and 14 read schemas/*.json,
# the service sources, agent/deploy.py, config/ladder.yaml and
# config/deploy_ladder.py from it. Phases 1 to 6 and 8 do not need it, and doing
# them early surfaces the tenant surprises while the code is being written.
export WALLE_REPO="<path-to-wall-e-repository>"

# The committed floor assertion. The action service refuses EVERY directory
# write if the protected set it computes at runtime does not cover this file.
export FLOOR_LIST_PATH="${WALLE_REPO}/config/protected_floor.txt"

# The OAuth client THIS SCRIPT uses to reach the Admin SDK as you. Not the
# robot's client, ever: one client, one token. Create it as manual step M0.
export OPERATOR_OAUTH_CLIENT_FILE="${HOME}/.walle/operator-client.json"

# Where your own OAuth token is cached, 0600. This is your credential, not
# Wall-E's. Set it to "" to re-consent on every run.
export OPERATOR_TOKEN_CACHE="${HOME}/.walle/operator-token.json"

# ---- Gemini Enterprise (decision D8) ----------------------------------------
# Look this up in the console BEFORE phase 6, because everything after it is
# regional. An eu app can front a europe-west1 agent; a global app can front any
# region; a us app cannot, and the fix is a new eu app, not a change in phase 13.
export GEMINI_APP_ID="<gemini-app-id>"
export GEMINI_APP_LOCATION="eu"

# ---- tunables with sane defaults --------------------------------------------
# The four playbook names in SETUP.md phase 14 are guesses. Replace them with
# the three admin tasks that actually waste the most of your time (D-list
# decision 12): Stage 0's shadow evidence is only useful if it shadows work you
# genuinely want done.
export PLAYBOOK_JOBS="licence-reclaim-suspended,leaver-group-hygiene,stale-account-report,admin-change-digest"
export PLAYBOOK_SCHEDULE="0 7 * * MON"
export TIMEZONE="Europe/Paris"

# Assumption: a sane Stage 0 ceiling. Adjust once the first cycle is measured.
export BUDGET_AMOUNT="200EUR"

# The Agent Runtime engine's display name. `walle teardown` deletes ONLY engines
# carrying this name, so a colleague's unrelated Agent Engine deployment in the
# same project and region is left alone. Change it and teardown stops
# recognising the engine this build created.
export ENGINE_DISPLAY_NAME="wall-e"

# ---- phases 12b, 12c and 13b: identity, Model Armor, registry ---------------
# Chapters 12, 11 and 13. Each key names the subcommand that validates it.

# `walle deploy`. AGENT_IDENTITY (the design's choice, decision 19) or
# SERVICE_ACCOUNT. identity_type is fixed when the engine is created and can
# never be patched, so this is decided BEFORE the first deploy. SERVICE_ACCOUNT
# is the gated fallback: deploy refuses it unless AGENT_IDENTITY_SPIKE_RESULT
# names an existing file, the spike's recorded output.
export AGENT_IDENTITY_MODE="AGENT_IDENTITY"

# `walle spike` writes here; `walle deploy` reads it. Three results (12b-a,
# 12b-b, 12b-c), pass or fail with raw output, never a token. Attach it to
# the decision record either way.
export AGENT_IDENTITY_SPIKE_RESULT="${WALLE_REPO}/drills/agent-identity-spike.json"

# `walle deploy`, optional. Produced by `walle armor` (Phase 12c). When set,
# the engine is bound to this Model Armor ingress gateway at creation; leave
# empty and the deploy prints a warning and binds nothing. Short name or full
# projects/.../agentGateways/... path.
export INGRESS_GATEWAY=""

# `walle registry`. The egress gateway's name. Default-deny for the reasoning
# layer; starts in DRY_RUN.
export EGRESS_GATEWAY="walle-egress"

# `walle armor`. The numeric folder holding the Wall-E project, or one created
# for it: the conformance floor (prompt injection at HIGH or stricter, malicious
# URL on) is pinned there so nothing below Wall-E can switch it off.
export FOLDER_ID="<folder-id>"

# `walle registry`. The CI deployer's service account EMAIL. It is the ONLY
# principal that may write the registry: an editor can redirect every consumer
# that resolves Wall-E through it.
export CI_DEPLOYER="<ci-deployer-service-account>"

# `walle registry`. Mo's principal, viewer on the registry. An IAM member
# ("serviceAccount:mo-analyst@..."; a bare email is taken as a service account).
export MO_PRINCIPAL="<mo-principal>"

# `walle armor --enforce` only. Path to the Stage 1 decision record
# (decision 24) that authorises the blocking flips. Empty means --enforce is
# refused, which is the correct state for the whole of Stage 0.
export MODEL_ARMOR_ENFORCE_DECISION=""

# `walle armor`. Retention of walle-content-logs, which carries raw prompts
# and personal data. Assumption: 30 days pending the data-protection position.
export CONTENT_LOG_RETENTION_DAYS="30"

# ---- filled in as each phase produces them ----------------------------------
# Come back on day three in a new terminal without these and half the commands
# expand to empty strings, which for --set-env-vars and --uri produces a
# deployed resource that is wrong rather than a command that fails.

# Phase 6. gcloud projects describe "$PROJECT" --format='value(projectNumber)'
export PROJECT_NUMBER=""

# Phase 9. The NUMBER the consent prints. It is 1 only on a first clean
# bootstrap: every rollback, every re-run and every K4 or K5 drill produces a
# higher one, and a stale pin points the service at a destroyed version.
# NEVER the string "latest": latest resolves to the newest ENABLED version, so
# disabling the newest silently falls back to the previous, still-valid token
# and the kill switch does nothing at all.
export REFRESH_TOKEN_VERSION=""

# Phase 15, the same for Eve's own credential.
export EVE_TOKEN_VERSION=""

# Phase 10.
export ACTIONS_URL=""
# Phase 11.
export DISPATCHER_URL=""
# Phase 12.
export ENGINE_ID=""

# Optional: pin an already-built image instead of rebuilding from the repo.
export ACTIONS_IMAGE=""
export DISPATCHER_IMAGE=""
